# انسخ إلى .env ثم املأ المفاتيح (بدون قيم حقيقية هنا أبداً)
DEEPSEEK_API_KEY=sk-ضع-مفتاحك-هنا
# اختياري: deepseek-chat (افتراضي) أو deepseek-reasoner
METWILY_MODEL=deepseek-chat
# مفاتيح Gemini المجانية للتناوب (من aistudio.google.com) — كل مفتاح إضافي يطيل العمل
GEMINI_API_KEY=ضع-مفتاحك-هنا
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# موديل Gemini (افتراضي: gemini-3.8-flash)
METWILY_GEMINI_MODEL=gemini-3.8-flash
# تعطيل الـ auto-commit: METWILY_AUTOCOMMIT=0 — تخطي التأكيد: METWILY_YES=1

# Local OpenAI-compatible proxy (AIClient-2-API). Set PROVIDER=proxy to force it.
METWILY_PROVIDER=
METWILY_PROXY_URL=
# AIClient-2-API default key is 123456
METWILY_PROXY_KEY=123456
# Comma-separated model ids for rotation (optional).
METWILY_PROXY_MODELS=
