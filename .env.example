# Copy this file to .env and fill values. Never commit real keys.
DEEPSEEK_API_KEY=sk-xxx
# Model: deepseek-chat (fast) or deepseek-reasoner
METWILY_MODEL=deepseek-chat
# Gemini free tier keys (from aistudio.google.com) - the agent rotates them
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Gemini model (default: gemini-3.8-flash)
METWILY_GEMINI_MODEL=gemini-3.8-flash
# Disable auto-commit: METWILY_AUTOCOMMIT=0 - skip confirmations: METWILY_YES=1

# Local OpenAI-compatible proxy (AIClient-2-API). Set PROVIDER=proxy to force it.
METWILY_PROVIDER=
METWILY_PROXY_URL=
# AIClient-2-API default key is 123456
METWILY_PROXY_KEY=123456
# Comma-separated model ids for rotation (optional).
METWILY_PROXY_MODELS=

# --- Local (Ollama) ---
# Ollama is used automatically when running at http://127.0.0.1:11434.
# Force fully local (no cloud fallback): METWILY_PROVIDER=ollama
METWILY_PROVIDER=
# Override the local model (default: metwily-local, then qwen3:1.7b)
METWILY_OLLAMA_MODEL=
# OpenAI-compatible base URL for the local server (default http://127.0.0.1:11434/v1)
AGENT_LLM_URL=
