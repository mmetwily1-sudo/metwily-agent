{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@metwily/core/*": ["packages/core/src/*"],
      "@metwily/llm/*": ["packages/llm/src/*"],
      "@metwily/tools/*": ["packages/tools/src/*"]
    }
  }
}
